  "Security": {
    "AuditSealKey": "REPLACE_WITH_A_SEPARATE_STRONG_SECRET_FOR_AUDIT_SEALS",
    "FieldEncryptionKey": "REPLACE_WITH_A_SEPARATE_STRONG_SECRET_FOR_FIELD_ENCRYPTION"
  },
  "Integration": {
    "ErpApiKey": ""
  },
  "Smtp": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "Username": "",
    "Password": "",
    "FromAddress": "noreply@teta.local",
    "FromName": "TETA IPPCMS"
  },
  "Documents": {
    "RootPath": "",
    "ScannerCommand": ""
  },
  "Teta": {
    "BootstrapAdmins": "admin"
  },
  "Seed": {
    "Enabled": true,
    "DemoData": false,
    "DemoPassword": ""
  },
  "Jobs": {
    "Enabled": true
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "RateLimiting": {
