<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    TETA-IPPCMS API host. Hosted as its own IIS application (/TETA) with its own app pool, so it runs
    independently of IFWEMS (/IFWEMS) while sharing the platform database, identity store and the
    shared platform libraries (security, audit, notifications).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Teta.Ippcms.Api</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.SqlServer" Version="8.0.2" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="8.0.4" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.4.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Teta.Ippcms.Infrastructure\Teta.Ippcms.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Teta.Ippcms.IntegrationTests" />
  </ItemGroup>

  <!-- Builds the Angular client (base href /, served at this app's own IIS site root) into
       wwwroot on publish; skip with -p:SkipAngularBuild=true. -->
  <PropertyGroup>
    <ClientDir>$(MSBuildProjectDirectory)\..\Teta.Ippcms.Client</ClientDir>
  </PropertyGroup>

  <Target Name="BuildAngularApp" BeforeTargets="Publish" Condition="'$(SkipAngularBuild)' != 'true'">
    <Message Importance="high" Text="Installing TETA Angular client dependencies..." />
    <Exec Command="npm ci" WorkingDirectory="$(ClientDir)" />
    <Message Importance="high" Text="Building TETA Angular client (production, base href /)..." />
    <Exec Command="npm run build -- --configuration production" WorkingDirectory="$(ClientDir)" />
    <ItemGroup>
      <AngularDist Include="$(ClientDir)\dist\teta.client\browser\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(AngularDist)" DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
