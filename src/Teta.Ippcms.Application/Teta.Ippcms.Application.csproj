<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TETA-IPPCMS application layer: use-case services per module, request/response contracts (DTOs),
    pure rule engines (evaluation scoring, project health, risk rating, schedule validation, business
    calendar) and cross-cutting services (data scope, workflow, delegations, SoD, notifications).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Teta.Ippcms.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.11" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Teta.Ippcms.Domain\Teta.Ippcms.Domain.csproj" />
    <ProjectReference Include="..\Shared\Platform.Security\Platform.Security.csproj" />
    <ProjectReference Include="..\Shared\Platform.Notifications\Platform.Notifications.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Teta.Ippcms.UnitTests" />
  </ItemGroup>

</Project>
