<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared audit-trail building blocks: change capture from the EF Core change tracker with
    redaction of sensitive fields, and HMAC "sealing" of audit records so any tampering at the
    database level is detectable (tamper-evident audit trail, TETA SEC-010 / IFWEMS FR-051).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Platform.Audit</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Platform.Core\Platform.Core.csproj" />
  </ItemGroup>

</Project>
