<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared security building blocks for all platform applications:
      * the shared identity store (dbo.Users, owned by IFWEMS's migrations) mapped read/write
        but excluded from other applications' migrations,
      * password verification compatible with IFWEMS's existing ASP.NET Core Identity hashes,
      * JWT issuing/validation, TOTP multi-factor authentication, field-level encryption and the
        HTTP current-user context.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Platform.Security</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.11" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="8.0.11" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Platform.Core\Platform.Core.csproj" />
  </ItemGroup>

</Project>
