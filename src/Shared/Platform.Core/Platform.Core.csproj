<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared platform kernel used by every application hosted on the platform (IFWEMS, TETA-IPPCMS).
    Holds cross-cutting abstractions only: current-user context, clock, exception types, paging,
    correlation IDs and RFC 7807 problem-details error handling. No business rules live here.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Platform.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
