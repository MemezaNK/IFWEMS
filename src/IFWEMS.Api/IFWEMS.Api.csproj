<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Microsoft.Data.SqlClient requires ICU/globalization support for Windows-authenticated
         (Trusted_Connection) SQL Server connections; invariant mode breaks every DB call. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="AspNetCore.HealthChecks.SqlServer" Version="8.0.2" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="8.0.4" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.4.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IFWEMS.Infrastructure\IFWEMS.Infrastructure.csproj" />
    <ProjectReference Include="..\IFWEMS.Application\IFWEMS.Application.csproj" />
  </ItemGroup>

  <!--
    Builds the Angular client and copies its production output into wwwroot so that a single
    `dotnet publish` produces a self-contained deployable site (API + SPA on one origin).
    Skips itself when SkipAngularBuild=true is passed (useful for API-only test/CI builds).
  -->
  <PropertyGroup>
    <ClientDir>$(MSBuildProjectDirectory)\..\IFWEMS.Client</ClientDir>
  </PropertyGroup>

  <Target Name="BuildAngularApp" BeforeTargets="Publish" Condition="'$(SkipAngularBuild)' != 'true'">
    <Message Importance="high" Text="Installing Angular client dependencies..." />
    <Exec Command="npm ci" WorkingDirectory="$(ClientDir)" />
    <Message Importance="high" Text="Building Angular client (production)..." />
    <Exec Command="npm run build -- --configuration production" WorkingDirectory="$(ClientDir)" />
    <ItemGroup>
      <AngularDist Include="$(ClientDir)\dist\ifwems.client\browser\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(AngularDist)" DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>

